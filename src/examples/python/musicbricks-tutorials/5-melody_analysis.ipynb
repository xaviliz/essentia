    "f, axarr = plt.subplots(2, sharex=True)\n",
    "axarr[0].plot(time,pitch)\n",
    "axarr[0].set_title('estimated pitch[Hz]')\n",
    "axarr[1].plot(time,pitchConf)\n",
    "axarr[1].set_title('pitch confidence')\n",
